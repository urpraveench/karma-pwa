# Copy to .env.local and fill in. Firebase web config values are not secrets:
# they identify the project. Security comes from firestore.rules + Firebase Auth.

# 'local' = test mode (data in this browser, demo login). 'firebase' = Firestore + Auth.
VITE_BACKEND=local
VITE_SHOW_DEV_HINT=true
VITE_ENABLE_GOOGLE=false

# Legal links. Leave empty to use the app's own pages at /terms/ and /privacy/.
VITE_TERMS_URL=
VITE_PRIVACY_URL=

# Firebase Console > Project settings > Your apps > Web app.
# Set AUTH_DOMAIN to your hosting domain (e.g. app.tiktym.com) so Google
# sign-in works when the app is installed on iPhone.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase App Check (reCAPTCHA Enterprise). Create a score-based web key for your hosting
# domains in Google Cloud console > Fraud Defense, then register it in Firebase > App Check >
# reCAPTCHA Enterprise. It has only a site key; there is no secret. Leave empty to keep App Check off.
VITE_RECAPTCHA_SITE_KEY=

# Google Analytics (GA4) measurement ID, e.g. G-XXXXXXXXXX (Firebase › Project settings › Integrations,
# or Analytics › Admin › Data streams). Analytics loads only after the user agrees. Leave empty to turn it off.
VITE_GA_MEASUREMENT_ID=
