# Copy to .env.local and fill in. Firebase web config values are not secrets:
# they identify the project. Security comes from firestore.rules + Firebase Auth.

# 'local' = test mode (data in this browser, demo login). 'firebase' = Firestore + Auth.
VITE_BACKEND=local
VITE_SHOW_DEV_HINT=true
VITE_ENABLE_GOOGLE=false

# Optional legal links, shown on sign-up. Required before public launch.
VITE_TERMS_URL=
VITE_PRIVACY_URL=

# Firebase Console > Project settings > Your apps > Web app.
# Set AUTH_DOMAIN to your hosting domain (e.g. tiktym.web.app) so Google
# sign-in works when the app is installed on iPhone.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase App Check (reCAPTCHA v3). Create a key for your hosting domain at
# https://www.google.com/recaptcha/admin and register its secret in Firebase > App Check.
# Leave empty to keep App Check off.
VITE_RECAPTCHA_SITE_KEY=
