{
  "name": "tiktym",
  "private": true,
  "version": "1.7.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test --headed; playwright show-report reports/e2e",
    "test:e2e:headless": "playwright test",
    "test:report": "REPORT=1 vitest run; vite preview --outDir reports/unit --port 4174 --open",
    "test:emulator": "PATH=/opt/homebrew/opt/openjdk@21/bin:$PATH firebase emulators:exec --only auth,firestore --project demo-tiktym 'vitest run --config vitest.emulator.config.ts'",
    "test:all": "npm test && npm run test:emulator && npm run test:e2e:headless",
    "og:image": "node scripts/og-image.mjs",
    "site:clips": "node scripts/record-clips.mjs",
    "email:header": "node scripts/email-header.mjs"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/ui": "^5.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
